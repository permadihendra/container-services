# .env

## Flask App Configuration
FLASK_APP=flask-app1
DATABASE_URL="postgresql://postgres:password@postgres-db:5432/mydatabase"

## Metabase Configuration
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase_db
MB_DB_USER=metabase_user
MB_DB_PASS=metabase_password
MB_DB_HOST=metabase-postgres
MB_DB_PORT=5432

## Shared Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase

# Healthcheck for Metabase (add to metabase-compose.yml)
HEALTHCHECK=CMD curl --fail http://localhost:3000/api/health || exit 1