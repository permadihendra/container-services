# =============================================================================
# REACT APPLICATION CONFIGURATION
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
#
# Unlike Flask applications, React runs on your host machine using the
# Vite development server — not inside a container. This file configures
# the Vite dev server and its connection to backend services.
# =============================================================================

# -----------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------

# APP_NAME
#
# Your application's name. Used for project identification and display.
#
# Examples:
#   APP_NAME=my-react-app
#   APP_NAME=admin-dashboard
#   APP_NAME=landing-page
APP_NAME=my-react-app

# APP_PORT
#
# The port the Vite development server will listen on.
# Vite will start on this port on your host machine.
#
# Examples:
#   APP_PORT=3000
#   APP_PORT=5173
#   APP_PORT=8080
APP_PORT=3000

# -----------------------------------------------------------------------
# SERVICE DEPENDENCIES
# -----------------------------------------------------------------------

# DEPENDS_ON
#
# A comma-separated list of infrastructure services that must be
# running before your application starts.
#
# Since React runs on your host machine (not in a container), it typically
# does not require any containerized infrastructure. Leave this empty
# unless your React app communicates with backend services.
#
# Available options:
#   postgres  - PostgreSQL database (port 5432)
#   nginx     - NGINX reverse proxy (port 8080)
#   metabase  - Metabase analytics (port 3000)
#
# Examples:
#   DEPENDS_ON=              No infrastructure needed (default)
#   DEPENDS_ON=nginx         You need the reverse proxy for API calls
#   DEPENDS_ON=postgres      You connect directly to the database
DEPENDS_ON=

# -----------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------

# VITE_API_URL
#
# The base URL for backend API requests. Your React application will
# send API calls to this URL. In development mode, this typically
# points to the NGINX reverse proxy.
#
# Examples:
#   VITE_API_URL=http://localhost:8080     Via NGINX proxy
#   VITE_API_URL=http://localhost:5000     Direct to Flask backend
#   VITE_API_URL=https://api.example.com  Production URL
VITE_API_URL=http://localhost:8080
