# =============================================================================
# FLASK APPLICATION CONFIGURATION
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# 
# The ./scripts/manage.sh start-dev --source . command reads this file
# to determine how to run your application in development mode.
# =============================================================================

# -----------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------

# APP_NAME
#
# Your application's name. This is used as the container name and
# displayed on the Flask home page.
#
# Examples:
#   APP_NAME=my-flask-app
#   APP_NAME=blog-api
#   APP_NAME=auth-service
APP_NAME=my-flask-app

# APP_PORT
#
# The port your Flask application will listen on.
#
# When using start-dev, the port is auto-assigned starting from 5002
# if this value is left unchanged. You may set a specific port here
# if you need a fixed value.
#
# Examples:
#   APP_PORT=5002
#   APP_PORT=8080
APP_PORT=5002

# -----------------------------------------------------------------------
# SERVICE DEPENDENCIES
# -----------------------------------------------------------------------

# DEPENDS_ON
#
# A comma-separated list of infrastructure services that must be
# running before your application starts. Only the services listed
# here will be started — nothing more.
#
# Available options:
#   postgres  - PostgreSQL database (port 5432)
#   nginx     - NGINX reverse proxy (port 8080)
#   metabase  - Metabase analytics (port 3000)
#
# Examples:
#   DEPENDS_ON=postgres              You need a database
#   DEPENDS_ON=postgres,nginx        You need a database and a proxy
#   DEPENDS_ON=                      You need no infrastructure
#
# Tip: Keep this minimal. Only declare what your app actually uses.
DEPENDS_ON=postgres

# -----------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------
# These settings are only used if DEPENDS_ON includes "postgres".
# The default values below match the credentials defined in
# compose-service/postgres-compose.yml.

# DB_HOST
#
# The hostname of your PostgreSQL server.
# When using --network host (the default), use "localhost".
#
# Examples:
#   DB_HOST=localhost
#   DB_HOST=postgres
DB_HOST=localhost

# DB_PORT
#
# The port your PostgreSQL server is listening on.
# The default PostgreSQL port is 5432.
DB_PORT=5432

# DB_NAME
#
# The name of the database your application will use.
# If the database does not exist, manage.sh will create it automatically
# when you start your application.
#
# Examples:
#   DB_NAME=blog_db
#   DB_NAME=auth_db
DB_NAME=my_flask_app_db

# DB_USER
#
# The PostgreSQL user that will connect to the database.
DB_USER=user

# DB_PASSWORD
#
# The password for the PostgreSQL user specified above.
DB_PASSWORD=password
